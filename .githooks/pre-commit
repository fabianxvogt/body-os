#!/bin/sh
# body-os guard: never commit personal data from the engine repo.
# Blocks staged paths under me/ or data/, .env* files, and *.jsonl outside examples/ that look like
# body-os log lines. Enable with: git config core.hooksPath .githooks
. "$(git rev-parse --show-toplevel)/.githooks/guard-lib.sh"

blocked=$(guard_check INDEX)
if [ -n "$blocked" ]; then
  printf 'body-os pre-commit: refusing to commit personal or secret data:\n%s\n' "$blocked" >&2
  echo "Unstage with: git restore --staged <path>   (me/ has its own private repo: git -C me commit)" >&2
  exit 1
fi
exit 0
