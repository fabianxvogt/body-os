#!/bin/sh
# body-os guard: refuse pushes if any pushed commit's full tree (merges included) contains me/,
# data/, .env* or log-like *.jsonl outside examples/. Enable with: git config core.hooksPath .githooks
. "$(git rev-parse --show-toplevel)/.githooks/guard-lib.sh"

blocked=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch deletion
  case "$remote_sha" in
    *[!0]*) commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || git rev-list "$local_sha" --not --remotes) ;;
    *) commits=$(git rev-list "$local_sha" --not --remotes) ;;
  esac
  for c in $commits; do
    out=$(guard_check "$c")
    [ -n "$out" ] && blocked="$blocked
commit $c:
$out"
  done
done

if [ -n "$blocked" ]; then
  printf 'body-os pre-push: refusing to push personal or secret data:%s\n' "$blocked" >&2
  echo "Rewrite those commits so the paths never existed, then push again." >&2
  exit 1
fi
exit 0
